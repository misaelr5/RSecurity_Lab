{
  "name": "reac-security-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/src/start.ts",
    "dev": "npm run build && npm start",
    "lint": "eslint apps packages tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "npm run typecheck && vite build apps/web",
    "smoke": "node scripts/smoke.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.3.8"
  }
}
